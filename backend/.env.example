# ============================================================
# NANYÉ API — modèle de configuration
# Copier en .env (jamais versionné) puis adapter. Aucun secret ici.
# ============================================================

# development | test | production
APP_ENV=development
DEBUG=false

# Local : SQLite. Production : PostgreSQL, ex. postgresql://user:motdepasse@hote:5432/nanye
DATABASE_URL=sqlite:///./nanye.db

# Origines autorisées à appeler l'API (frontend), séparées par des virgules.
# Production : https uniquement, jamais "*".
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# URL publiques (liens de réinitialisation, retour et notification de paiement)
FRONTEND_BASE_URL=http://localhost:5500/index.html
API_BASE_URL=http://localhost:8000

# Cookies de session
# Production : COOKIE_SECURE=true. Garder "lax" si le site et l'API partagent le même
# domaine (nanye.com + api.nanye.com). "none" uniquement si domaines différents (+ Secure).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
SESSION_LIFETIME_HOURS=168
SESSION_IDLE_HOURS=48

# Commandes
SHIPPING_FEE_XOF=0
MAX_QUANTITY_PER_ITEM=20
ORDER_PAYMENT_TIMEOUT_MINUTES=30

# Paiement : disabled | simulator (développement uniquement) | cinetpay
PAYMENT_PROVIDER=simulator
# Production avant l'ouverture des paiements réels : PAYMENT_PROVIDER=simulator +
# ALLOW_SIMULATED_PAYMENTS=true. Le site affiche alors un bandeau « démonstration »
# et l'administration compte ces ventes à part (aucune somme n'est encaissée).
ALLOW_SIMULATED_PAYMENTS=false
# Identifiants CinetPay (espace marchand > Intégrations). À fournir via le gestionnaire
# de secrets de l'hébergeur en production.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_CHANNELS=ALL

# Emails : disabled | console (développement : affiche le message dans le terminal) | smtp
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

LOG_LEVEL=INFO
